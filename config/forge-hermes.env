# FORGE-OS local model defaults. A user-saved FORGE setting remains authoritative.
# Override FORGE_OLLAMA_MODEL with the Ollama model installed on the machine.
export FORGE_AGENT_RUNTIME="${FORGE_AGENT_RUNTIME:-hermes}"
export FORGE_HERMES_ENDPOINT="${FORGE_HERMES_ENDPOINT:-http://127.0.0.1:11434/v1}"
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$FORGE_HERMES_ENDPOINT}"
export OPENAI_MODEL="${FORGE_OLLAMA_MODEL:-${OPENAI_MODEL:-llama3.2:3b}}"
