#!/usr/bin/env bash
set -euo pipefail

[[ "$EUID" -ne 0 ]] || { echo 'Run the FORGE-OS updater as the signed-in user, not root.' >&2; exit 77; }

forge_repository="${FORGE_SOURCE_DIR:-$HOME/FORGE}"
os_repository="${FORGE_OS_SOURCE_DIR:-$HOME/FORGE-OS}"

repositories=("$forge_repository" "$os_repository")
expected_origins=(
  'https://github.com/North3rnLight3r/FORGE'
  'https://github.com/North3rnLight3r/FORGE-OS'
)

attach_main_if_safe() {
  local repository="$1" current head main_head
  current="$(git -C "$repository" branch --show-current)"
  [[ "$current" == main ]] && return 0
  [[ -z "$current" ]] || return 1
  head="$(git -C "$repository" rev-parse HEAD)"
  main_head="$(git -C "$repository" rev-parse refs/heads/main 2>/dev/null || true)"
  [[ -n "$main_head" && "$head" == "$main_head" ]] || return 1
  git -C "$repository" switch main >/dev/null
}

for index in "${!repositories[@]}"; do
  repository="${repositories[$index]}"
  [[ -d "$repository/.git" ]] || { echo "Required Git checkout is missing: $repository" >&2; exit 66; }
  if ! attach_main_if_safe "$repository"; then
    echo "Update checkout must be on main (or safely attached to its local main commit): $repository" >&2
    exit 65
  fi
  [[ "$(git -C "$repository" branch --show-current)" == main ]] || { echo "Update checkout must be on main: $repository" >&2; exit 65; }
  [[ -z "$(git -C "$repository" status --porcelain -- . ':(exclude).obsidian/**')" ]] || { echo "Update checkout has source changes outside .obsidian: $repository" >&2; exit 65; }
  origin="$(git -C "$repository" config --get remote.origin.url)"
  [[ "${origin%.git}" == "${expected_origins[$index]}" ]] || {
    echo "Update checkout has an untrusted origin: $repository ($origin)" >&2
    exit 65
  }
done

forge_before="$(git -C "$forge_repository" rev-parse HEAD)"
os_before="$(git -C "$os_repository" rev-parse HEAD)"
obsidian_stashed=(false false)
for index in "${!repositories[@]}"; do
  repository="${repositories[$index]}"
  if [[ -n "$(git -C "$repository" status --porcelain -- .obsidian 2>/dev/null)" ]]; then
    git -C "$repository" stash push --include-untracked --message 'FORGE-OS updater local Obsidian state' -- .obsidian >/dev/null
    obsidian_stashed[$index]=true
  fi
done

apply_obsidian_stashes() {
  for index in "${!repositories[@]}"; do
    [[ "${obsidian_stashed[$index]}" == true ]] || continue
    git -C "${repositories[$index]}" stash apply --index 'stash@{0}' >/dev/null
  done
}

drop_obsidian_stashes() {
  for index in "${!repositories[@]}"; do
    [[ "${obsidian_stashed[$index]}" == true ]] || continue
    git -C "${repositories[$index]}" stash drop 'stash@{0}' >/dev/null
    obsidian_stashed[$index]=false
  done
}

rollback_sources=true
restore_sources_on_failure() {
  local status=$?
  trap - EXIT
  if [[ "$rollback_sources" == true ]]; then
    echo 'Update failed; restoring both clean source checkouts to their pre-update commits.' >&2
    git -C "$forge_repository" reset --hard "$forge_before" >/dev/null
    git -C "$os_repository" reset --hard "$os_before" >/dev/null
  fi
  if apply_obsidian_stashes; then
    drop_obsidian_stashes
  else
    echo 'Local Obsidian state remains in each affected repository stash because it could not be restored automatically.' >&2
  fi
  exit "$status"
}
trap restore_sources_on_failure EXIT

echo 'Checking the trusted FORGE and FORGE-OS origins...'
git -C "$forge_repository" fetch --prune origin main
git -C "$os_repository" fetch --prune origin main

for repository in "${repositories[@]}"; do
  git -C "$repository" merge-base --is-ancestor HEAD origin/main || {
    echo "Local history has diverged from origin/main: $repository" >&2
    exit 65
  }
done

# Save the complete currently installed FORGE-owned integration layer before
# changing either source tree. Prefer the installed root-owned helper; use bash
# on the repository copy as a recovery-compatible fallback so source file mode
# cannot make an otherwise valid update fail.
if [[ -x /usr/local/libexec/forge-system-checkpoint && -z "${FORGE_UPDATE_TEST_UNPRIVILEGED:-}" && -z "${FORGE_OS_SOURCE_DIR:-}" ]]; then
  sudo /usr/local/libexec/forge-system-checkpoint "$forge_before" "$os_before"
elif [[ -r "$os_repository/scripts/forge-system-checkpoint" ]]; then
  sudo bash "$os_repository/scripts/forge-system-checkpoint" "$forge_before" "$os_before"
else
  echo 'System checkpoint helper is missing from FORGE-OS.' >&2
  exit 69
fi

git -C "$forge_repository" merge --ff-only origin/main
git -C "$os_repository" merge --ff-only origin/main

echo 'Installing the verified FORGE-OS update...'
"$os_repository/scripts/install-forge-linux.sh"

apply_obsidian_stashes
drop_obsidian_stashes
rollback_sources=false
trap - EXIT

echo
echo 'FORGE-OS is updated. The pre-update system checkpoint is available from Advanced -> Roll back system checkpoint. Reboot when convenient to enter the newly installed session stack.'
